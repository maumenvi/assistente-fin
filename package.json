{
  "name": "assistente-fin",
  "license": "SEE LICENSE IN LICENSE",
  "version": "1.0.40",
  "description": "Aplicativo de controle financeiro pessoal para desktop e celular.",
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "electron-vite dev",
    "desktop:build": "prisma generate && electron-vite build",
    "desktop:preview": "electron-vite preview",
    "e2e": "electron-vite build && playwright test",
    "dist:appimage": "npm run desktop:build && electron-builder --linux AppImage",
    "dist:dir": "npm run desktop:build && electron-builder --linux dir",
    "dist:flatpak": "scripts/build-flatpak.sh",
    "icons": "node scripts/icons/make.icons.ts",
    "version:bump": "node scripts/bump-version.ts",
    "predist:appimage": "node scripts/bump-version.ts",
    "predist:flatpak": "node scripts/bump-version.ts",
    "premobile:build:apk": "node scripts/bump-version.ts",
    "release": "node scripts/bump-version.ts && FC_VERSION_BUMPED=1 npm run dist:appimage && FC_VERSION_BUMPED=1 npm run dist:flatpak && FC_VERSION_BUMPED=1 npm run mobile:build:apk",
    "db:up": "podman-compose up -d postgres",
    "db:up:test": "podman-compose --profile test up -d",
    "db:down": "podman-compose down",
    "db:logs": "podman-compose logs -f postgres",
    "db:psql": "podman-compose exec postgres psql -U finance -d finance_controller",
    "db:generate": "node --env-file=.env node_modules/.bin/prisma generate",
    "db:migrate": "node --env-file=.env node_modules/.bin/prisma migrate dev",
    "db:migrate:deploy": "node --env-file=.env node_modules/.bin/prisma migrate deploy",
    "dev:codes": "node --env-file=.env scripts/dev-codes.ts",
    "migrate:transfer-category": "node --env-file=.env scripts/migrate-transfer-category.ts",
    "sync:opening-balance": "node --env-file=.env scripts/sync-opening-balance.ts",
    "mobile:typecheck": "npm --prefix src/react-native run typecheck",
    "mobile:build:apk": "npm --prefix src/react-native run build:apk"
  },
  "keywords": [],
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "main": "./out/main/index.js",
  "desktopName": "org.financecontroller.FinanceController.desktop",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "fastify": "5.12.4",
    "fflate": "^0.8.3",
    "nodemailer": "^10.0.1",
    "pdfjs-dist": "4.10.38",
    "pg": "^8.16.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prisma": "7.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}

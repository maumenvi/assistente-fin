NODE_ENV=development

# Persistencia (RF-20, RF-21). driver: fake | prisma
DATABASE_DRIVER=prisma

# Envio de codigo de verificacao (RF-25). driver: fake (unico ate um provedor real entrar)
NOTIFICATION_DRIVER=fake

# Credenciais do Postgres local (compose.yaml)
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance_controller
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# URL usada pelo Prisma / adaptador prisma
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance_controller?schema=public

# URL do banco de teste (habilita a suite de contrato contra Postgres; senao ela e pulada)
DATABASE_URL_TEST=postgresql://finance:finance@localhost:5433/finance_controller_test?schema=public

# Cifra os codigos de verificacao em repouso, AES-256-GCM (revisao Fase 4). Obrigatoria com
# DATABASE_DRIVER=prisma. 32 bytes, em hex (64 chars) ou base64. Gere uma com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
VERIFICATION_CODE_KEY=
